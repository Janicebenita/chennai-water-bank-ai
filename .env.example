# Safe, zero-credential hackathon defaults
DATA_BACKEND=memory
DEMO_MODE=true
PORT=8080

# Optional Firestore mode (uses Application Default Credentials)
# DATA_BACKEND=firestore
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# FIRESTORE_DATABASE=(default)

# Optional Moss semantic memory. Exact live operational values remain in the
# Water Bank repository; Moss contains only explicitly indexed WaterEvents.
MOSS_ENABLED=false
# MOSS_PROJECT_ID=your-moss-project-id
# MOSS_PROJECT_KEY=your-moss-project-key
MOSS_INDEX_NAME=chennai-water-bank-events
MOSS_TOP_K=4
